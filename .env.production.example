# =============================================================================
# 生产 / 线上环境模板
# 用法：复制为 .env.production 后填写真实值
# 读取：npm run start / docker compose / scripts/deploy-manual.sh
# =============================================================================

# --- 服务端口 ---
# 后端 API 监听端口（docker-compose 端口映射也依赖此值）
SERVER_PORT=5409

# --- 前端 / API 地址 ---
# 浏览器访问后端的公开地址（需与域名、反代一致）
VITE_API_BASE_URL=
# 生产通过同源反向代理访问 Sub2API 时留空；独立域名部署可填写 Sub 地址
VITE_SUB2API_BASE_URL=
# 同源反向代理挂载路径；Sub 菜单入口使用 /duomi-studio/
VITE_BASE_PATH=/duomi-studio/

# --- Sub2API 身份与生成网关 ---
SUB2API_BASE_URL=https://subapi.duomi.cloud

# --- Duomi R2 / S3 兼容存储 ---
# 与 Sub 的 CF R2 使用同一组凭据，但通过 duomi/ 前缀隔离数据
DUOMI_STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
DUOMI_STORAGE_REGION=auto
DUOMI_STORAGE_BUCKET=your-r2-bucket
DUOMI_STORAGE_ACCESS_KEY_ID=your-r2-access-key
DUOMI_STORAGE_SECRET_ACCESS_KEY=your-r2-secret-key
DUOMI_STORAGE_PUBLIC_BASE_URL=
DUOMI_STORAGE_PREFIX=duomi/

# --- 静态资源与上传 ---
# Docker 容器内前端构建产物路径
STATIC_DIST_DIR=/app/dist
# Docker 容器内上传文件持久化目录（建议挂载 volume）
UPLOADS_DIR=/app/uploads

# --- 跨域 ---
# 允许访问 API 的前端域名，多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=https://subapi.duomi.cloud,https://duomi.cloud

# --- MySQL / MariaDB ---
# 默认部署 Compose 会启动独立 MariaDB，DATABASE_URL 使用服务名 mariadb。
MARIADB_DATABASE=duomi_ai_studio
MARIADB_USER=duomi
MARIADB_PASSWORD=please-change-this-database-password
MARIADB_ROOT_PASSWORD=please-change-this-root-password
DATABASE_URL=mysql://duomi:please-change-this-database-password@mariadb:3306/duomi_ai_studio?allowPublicKeyRetrieval=true

# --- 加密密钥 ---
# 生产环境必须更换为足够长的随机字符串
PROVIDER_CONFIG_SECRET=please-change-this-provider-secret
STORAGE_CONFIG_SECRET=please-change-this-storage-secret

# --- 登录与会话 ---
AUTH_LOGIN_CODE_EXPIRE_MINUTES=5
AUTH_SESSION_EXPIRE_DAYS=30

# --- Redis ---
REDIS_ENABLED=true
# 独立 Redis 填真实 IP/域名；docker-compose 同栈 Redis 服务填 redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_URL=
REDIS_PREFIX=duomi-ai-studio
REDIS_ENV=production

# --- Docker Compose 覆盖示例 ---
# APP_ENV_FILE=./.env.production
# 若 MySQL 在宿主机：DATABASE_URL=mysql://user:pass@host.docker.internal:3306/duomi_ai_studio?allowPublicKeyRetrieval=true
# 若 Redis 在同 compose 栈：REDIS_HOST=redis
